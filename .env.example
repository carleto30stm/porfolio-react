# Copy to .env and set your GitHub user and optionally a Personal Access Token (PAT)
# If most of your contributions are in private repos, add a PAT with `repo` scope so the app can read private contributions.
VITE_GITHUB_USERNAME=tu-usuario
# Optional (improves rate limits and shows private contributions):
# VITE_GITHUB_TOKEN=ghp_xxx_your_token_here

# Formspree form ID (from https://formspree.io/f/xxxxxxxx → the last part)
VITE_FORMSPREE_ID=xxxxxxxx
